<?xml version="1.0" encoding="utf-8"?>
<!-- NOVA orbit mark — monochrome system/status-bar rendition of the app icon.
     Far arc → orb → near arc, so the ring reads as crossing the planet
     (tools/make-app-icon.sh draws the full-colour AURA master). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- the far arc of the ring, behind the orb -->
    <path
        android:fillColor="#00000000"
        android:pathData="M3.8,13.4 A 8.2,2.9 0 0 1 20.2,13.4"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="1.1"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <!-- the orb: indigo → mint in colour, white in the status bar -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M12,6.6a5.4,5.4 0 1,0 0,10.8a5.4,5.4 0 1,0 0,-10.8z" />
    <!-- the near arc, in front of the orb -->
    <path
        android:fillColor="#00000000"
        android:pathData="M20.2,13.4 A 8.2,2.9 0 0 1 3.8,13.4"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="1.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
</vector>
